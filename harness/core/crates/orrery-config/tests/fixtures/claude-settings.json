{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Read(./src/**)",
      "Grep",
      "mcp__github__get_issue",
      "WebFetch(domain:docs.rs)"
    ],
    "ask": [
      "Write(./**)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(curl:*)",
      "WebFetch(domain:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_TOKEN": "" }
    }
  },
  "model": "claude-sonnet-4-5",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "orrery hook" }] }
    ]
  }
}
