{
  "name": "@orrery/client-ink",
  "version": "0.0.0",
  "private": true,
  "description": "The React/Ink Orrery TUI, spawned as a Node process against a running kernel.",
  "type": "module",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kouji-dev/orrery",
    "directory": "harness/clients/ink"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --target=node20 --alias:react-devtools-core=./src/devtools-stub.ts --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "pnpm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@orrery/client": "workspace:*",
    "@orrery/protocol": "workspace:*",
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
