// The Orrery extension world.
//
// Implementation plan: harness/docs/plans/14-wasm-wit.md
//
// This is the FROZEN contract (plan 14, task 1). Every WASM-target language
// binds against it, and it is the same schema the JSON-RPC paths serialise.
// Changing the shapes below — the arena above all — is a major version bump of
// `orrery:extension`, not an edit.
//
// Two rules it exists to make structural:
//
//   1. The guest never holds a capability token. The type is not serialisable,
//      so it physically cannot cross this boundary. Every capability arrives as
//      an imported host function; the host looks up the current call's token on
//      its own side. The guest asks, the host decides.
//   2. There are no WASI preopens. The filesystem arrives only through
//      `broker.read-file` / `broker.write-file`. A preopen would be a hole
//      straight past the policy engine.

package orrery:extension@1.0.0;

/// Everything an extension can reach outside itself. Each function is gated by
/// the policy engine host-side before it does anything.
interface broker {
    /// Why an operation did not happen. Denial and budget stops are values, not
    /// failures: the guest is expected to report them and re-plan, not retry.
    ///
    /// A denial is deliberately NOT a trap. The guest gets a value it can
    /// handle, report and plan around; trapping would make "you may not do
    /// that" indistinguishable from "your code is broken".
    variant error {
        /// A policy rule said no. Terminal — retrying will not help.
        denied(string),
        /// A budget ceiling was reached.
        budget(string),
        /// The operation was attempted and the platform refused.
        io(string),
        /// The turn was cancelled. Work stopped; it was not undone.
        cancelled,
    }

    /// Ceilings for one spawned process.
    record run-opts {
        /// Wall-clock ceiling in milliseconds. 0 means the call's remaining budget.
        timeout-ms: u64,
        /// Output ceiling. Output is truncated at it, never buffered whole.
        max-output-bytes: u64,
    }

    /// What a spawned process produced.
    record proc-out {
        /// The child's exit code.
        exit-code: s32,
        /// Standard output, up to `max-output-bytes`.
        stdout: list<u8>,
        /// Standard error, up to `max-output-bytes`.
        stderr: list<u8>,
        /// True when either stream hit the ceiling.
        truncated: bool,
    }

    /// What a bounded read returned.
    record file-out {
        /// The bytes, up to `max-bytes`.
        bytes: list<u8>,
        /// True when the file was longer than `max-bytes`.
        truncated: bool,
    }

    /// One outbound HTTP request.
    record fetch-opts {
        /// The HTTP method.
        method: string,
        /// Request headers, as name/value pairs.
        headers: list<tuple<string, string>>,
        /// The request body, if any.
        body: option<list<u8>>,
        /// Wall-clock ceiling in milliseconds.
        timeout-ms: u64,
        /// Response ceiling in bytes.
        max-response-bytes: u64,
    }

    /// What an outbound HTTP request returned.
    record fetch-out {
        /// The HTTP status code.
        status: u16,
        /// Response headers.
        headers: list<tuple<string, string>>,
        /// The response body, up to `max-response-bytes`.
        body: list<u8>,
        /// True when the body hit the ceiling.
        truncated: bool,
    }

    /// How a credential is about to be used, so the grant can be narrowed to it.
    record cred-usage {
        /// The host the credential will be sent to.
        host: string,
        /// The purpose recorded in the audit ledger.
        purpose: string,
    }

    /// Spawn a process under the call's containment and budget.
    run-proc: func(cmd: string, args: list<string>, opts: run-opts) -> result<proc-out, error>;

    /// Read a file, truncated at `max-bytes`. Never reads to end.
    read-file: func(path: string, max-bytes: u64) -> result<file-out, error>;

    /// Write a file. With `atomic`, the broker writes a temp file and renames,
    /// so a cancelled write leaves the original intact.
    write-file: func(path: string, bytes: list<u8>, atomic: bool) -> result<_, error>;

    /// Make one outbound HTTP request.
    fetch: func(url: string, opts: fetch-opts) -> result<fetch-out, error>;

    /// Ask the broker to attach a credential to an upcoming call. The secret
    /// itself never enters guest memory.
    use-credential: func(name: string, usage: cred-usage) -> result<_, error>;
}

/// The surface vocabulary, flattened.
///
/// TRANSLATION #9, and the largest single impedance mismatch in the design:
/// WIT has no recursive types, but `Surface` has `stack.children: Vec<Surface>`
/// and `custom.fallback: Box<Surface>`. Across this boundary a surface is a
/// flat arena — a `list<surface-node>` plus child indices — rebuilt host-side
/// into the real `Surface`.
///
/// FROZEN. The invariants the host enforces on arrival, and that a guest may
/// therefore rely on:
///
///   1. `kind` must agree with the `t` tag inside `payload`.
///   2. Every index in `children` is STRICTLY GREATER than the node's own
///      index, so the arena cannot loop and can be walked without a visited set.
///   3. Nodes are written parent-first, depth-first.
///   4. Only `stack` (any number) and `custom` (exactly one — its fallback)
///      carry children. Every other kind carries none.
interface surfaces {
    /// How far along whatever produced a node is.
    enum node-status {
        /// Not started.
        pending,
        /// In flight; more patches are coming.
        running,
        /// Finished, successfully.
        done,
        /// Finished, unsuccessfully.
        failed,
        /// Stopped before it finished.
        cancelled,
    }

    /// Which kind of node this is — one per `SurfaceKind` variant.
    ///
    /// Payload-carrying fields travel in `surface-node.payload`, because a
    /// variant with recursive payloads is exactly what WIT cannot express.
    enum node-kind {
        /// A run of text.
        text,
        /// Rows under headers.
        table,
        /// A hierarchy.
        tree,
        /// A change to one file.
        diff,
        /// Something taking a while.
        progress,
        /// An append-only channel.
        %stream,
        /// A checklist.
        task,
        /// A question the run is blocked on.
        question,
        /// Several values collected at once.
        form,
        /// Other surfaces, arranged. Carries its children.
        stack,
        /// Markdown.
        markdown,
        /// An extension-defined node. Carries exactly one child: the fallback
        /// to draw instead, which is mandatory — a custom node nobody can draw
        /// is a blank hole in a transcript.
        custom,
    }

    /// One node of the arena.
    record surface-node {
        /// What kind of node this is. Must agree with `payload`'s `t` tag.
        kind: node-kind,
        /// The handle a patch addresses this surface by. A uuid, as a string.
        id: option<string>,
        /// How far along it is.
        status: option<node-status>,
        /// The node's own payload, JSON-encoded, WITHOUT its recursive fields —
        /// `stack.children` and `custom.fallback` live in `children` instead.
        ///
        /// FLAGGED in `00-overview.md`: JSON crosses as a `string`, so payloads
        /// double-encode. MEASURED — see plan 14, task 7.
        payload: string,
        /// Indices into `surface.nodes`. Each must be greater than this node's
        /// own index, so the arena is acyclic by construction.
        children: list<u32>,
    }

    /// A whole surface as an arena.
    record surface {
        /// Every node, parent-first and depth-first.
        nodes: list<surface-node>,
        /// The index of the root node.
        root: u32,
    }
}

/// What an extension exports.
interface tools {
    use surfaces.{surface};

    /// Call one tool by its unqualified name. `input` is JSON against the
    /// tool's declared schema; the error string is the failure message the
    /// model sees.
    call: func(name: string, input: string) -> result<surface, string>;
}

/// The world a wasm extension is compiled against.
world orrery-extension {
    import broker;
    export tools;
}
