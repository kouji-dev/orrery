{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orrery",
  "version": "0.10.0",
  "identifier": "com.kouji.orrery",
  "build": {
    "beforeDevCommand": "node scripts/stage-updater-stub.mjs && pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/stage-updater-stub.mjs",
    "frontendDist": "../dist/orrery/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Orrery",
        "width": 1600,
        "height": 800,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "binaries/orrery-updater.exe": "binaries/orrery-updater.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "CB7D1311-3BE0-4D98-A8BA-AE4FB08907FC",
        "template": "wix/main.wxs"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kouji-dev/orrery-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NzIxQTAyMThFNzMwRTUKUldUbE1PY1lBaHB5eGFUa3RvMW5iMXBkelhhQ1JqTVUyeXVHNG1UVGxZUW9HZXpMZUpTY3Q1dCsK"
    }
  }
}
