# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
dist/
target/
target-test/
tmp/
out-tsc/
bazel-out/

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
.angular/cache/
.sass-cache/
connect.lock
coverage/
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# scratch verification screenshots
.verify/
/Screenshot *.png

# graphify artifacts (local only)
.graphify_*
.graphify_python/
graphify-out/

# local env & tooling
.env
# rtk writes its savings database to `rtk/` here and `.rtk/` elsewhere; both are
# local tool state, never source.
.rtk/
rtk/

# The clean-artefacts script's run output, not its input.
ade/scripts/.clean-list.txt

# transient build/dev logs
.cargobuild.log
.ngserve.log

# playwright (e2e) artifacts
test-results/
playwright-report/

# extension packs (registry build pipeline)
dist-ext/
.ext-build/

# Orrery Harness runtime state (sessions.db, trust answers, installed extensions)
.orrery/

# ── Junk that actually turned up while building the harness ──────────────
# Cygwin/Git-Bash crash dumps (rtk shells them out; these reappeared repeatedly)
*.stackdump

# Rejected/backup hunks from patch and merge tools
*.orig
*.rej

# insta snapshot drafts — review then `cargo insta accept`, never commit the .new
*.snap.new
*.pending-snap

# Coverage instrumentation
*.profraw
*.profdata

# Ad-hoc dev/build logs (the named ones above stay for clarity)
dev.log
*.local.log

# Angular's whole cache dir, not just cache/ — it also writes .angular/ at ade/
.angular/

# Claude Code: personal, machine-specific settings (CARGO_TARGET_DIR etc.)
.claude/settings.local.json
